# Copiar a .env y ajustar. chmod 600 .env en el servidor.

# Ruta de la base SQLite (default: data/sismo.db junto a app.py)
#SISMO_DB=/opt/soscali/backend/data/sismo.db

# Secreto del JWT del panel admin — OBLIGATORIO. Generar:
#   python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET_KEY=

# Horas de vigencia de la sesión admin (default 8)
#ACCESS_TOKEN_EXPIRE_HOURS=8

# API key de TomTom para el autocompletado de direcciones (opcional).
# Sin ella, el autocompletado usa Photon/OSM (gratuito, menos preciso).
# Crear gratis (sin tarjeta) en https://developer.tomtom.com → My Dashboard
# → Keys. La key vive SOLO aquí: el navegador consulta /api/direcciones y
# este backend habla con TomTom.
#TOMTOM_KEY=

